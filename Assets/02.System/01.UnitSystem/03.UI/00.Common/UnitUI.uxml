<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; justify-content: space-between; padding: 20px;">
        <!-- Dark Souls 3 Style Bottom-Left Single QuickSlot UI Container -->
        <ui:VisualElement name="QuickSlotContainer" picking-mode="Ignore" style="position: absolute; bottom: 30px; left: 30px; width: 100px; height: 100px; background-color: rgba(12, 14, 20, 0.9); border-width: 2px; border-color: rgba(212, 175, 55, 0.85); border-radius: 14px; align-items: center; justify-content: center; padding: 6px;">
            <ui:VisualElement name="HighlightOutline" picking-mode="Ignore" style="position: absolute; width: 92px; height: 92px; border-color: rgb(255, 215, 0); border-width: 2px; border-radius: 10px; display: none;" />
            <ui:VisualElement name="SelectedUnitIcon" picking-mode="Ignore" style="width: 64px; height: 64px; margin-bottom: 2px;" />
            <ui:Label name="ManaCostText" picking-mode="Ignore" text="Cost: 0" style="color: rgb(240, 240, 240); font-size: 13px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0.6); padding-left: 6px; padding-right: 6px; border-radius: 4px;" />
            <ui:Label name="WheelGuideText" picking-mode="Ignore" text="[Wheel]" style="position: absolute; top: -18px; color: rgba(212, 175, 55, 0.75); font-size: 11px; -unity-font-style: bold;" />
        </ui:VisualElement>

        <!-- Test Unlock Buttons Container (Top Right Corner) -->
        <ui:VisualElement name="UnlockButtonContainer" picking-mode="Ignore" style="position: absolute; top: 20px; right: 20px; flex-direction: column; align-items: flex-end; background-color: rgba(0, 0, 0, 0.7); padding: 8px; border-radius: 6px;">
        </ui:VisualElement>

        <!-- Inventory Window (33번: 창 틀 = 제목/드래그 영역 + ItemType 탭 바 + 내용 영역, 가변형 UI — translate로 드래그 이동) -->
        <ui:VisualElement name="InventoryContainer" style="position: absolute; left: 50%; top: 50%; margin-left: -320px; margin-top: -240px; width: 640px; height: 480px; flex-direction: column; background-color: rgba(10, 10, 15, 0.95); border-color: rgb(255, 215, 0); border-width: 2px; border-radius: 12px; display: none;">
            <ui:VisualElement name="InventoryTitleBar" style="flex-direction: row; align-items: center; flex-shrink: 0; height: 32px; padding-left: 16px; padding-right: 16px; background-color: rgba(255, 215, 0, 0.12); border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <ui:Label name="InventoryTitleText" picking-mode="Ignore" text="인벤토리" style="color: rgb(255, 215, 0); font-size: 15px; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement name="InventoryTabBar" picking-mode="Ignore" style="flex-direction: row; flex-shrink: 0; padding-left: 16px; padding-right: 16px; padding-top: 8px;" />
            <ui:VisualElement name="InventoryContent" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 16px;" />
        </ui:VisualElement>

        <!-- Target Object Info & Hover Visual Feedback Container -->
        <ui:VisualElement name="TargetInfoContainer" picking-mode="Ignore" style="position: absolute; bottom: 20px; right: 20px; background-color: rgba(0, 0, 0, 0.85); border-color: rgb(255, 215, 0); border-width: 2px; border-radius: 8px; padding: 12px; display: none;">
            <ui:Label name="TargetNameText" picking-mode="Ignore" text="Target: None" style="color: rgb(255, 215, 0); font-size: 16px; -unity-font-style: bold; margin-bottom: 4px;" />
            <ui:Label name="TargetUnitsText" picking-mode="Ignore" text="Units: Mass_Kg (10.0)" style="color: rgb(255, 255, 255); font-size: 14px;" />
        </ui:VisualElement>

        <!-- Unlock Popup Panel -->
        <ui:VisualElement name="PopupPanel" style="position: absolute; top: 30%; left: 35%; width: 300px; height: 180px; background-color: rgba(20, 20, 20, 0.9); border-color: rgb(255, 215, 0); border-width: 2px; border-radius: 12px; align-items: center; justify-content: center; display: none;">
            <ui:Label name="PopupTitleText" picking-mode="Ignore" text="Unit Unlocked!" style="color: rgb(255, 215, 0); font-size: 20px; margin-bottom: 10px; -unity-font-style: bold;" />
            <ui:VisualElement name="PopupIconImage" picking-mode="Ignore" style="width: 64px; height: 64px;" />
        </ui:VisualElement>

        <!-- Magic Selection Popup (33원정대 스타일 Q/W/E/F 선택지, 12번 기획서) -->
        <ui:VisualElement name="MagicSelectionPopupContainer" picking-mode="Ignore" style="position: absolute; top: 50%; right: 80px; translate: 0 -50%; flex-direction: column; align-items: flex-end; display: none;">
            <!-- Q: 장착 유닛 전체 목록 토글 -->
            <ui:VisualElement name="MagicChoiceQRow" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-bottom: 18px;">
                <ui:VisualElement picking-mode="Ignore" style="width: 36px; height: 36px; background-color: rgba(12, 14, 20, 0.9); border-width: 2px; border-color: rgba(212, 175, 55, 0.85); border-radius: 8px; align-items: center; justify-content: center; margin-right: 10px;">
                    <ui:Label picking-mode="Ignore" text="Q" style="color: rgb(255, 215, 0); font-size: 16px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:Label picking-mode="Ignore" text="전체 목록" style="color: rgb(240, 240, 240); font-size: 13px; background-color: rgba(0, 0, 0, 0.6); padding-left: 6px; padding-right: 6px; border-radius: 4px;" />
            </ui:VisualElement>

            <!-- W: 즐겨찾기 슬롯 0 -->
            <ui:VisualElement name="FavoriteSlotW" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-bottom: 14px; margin-right: 20px; background-color: rgba(0, 0, 0, 0); border-radius: 8px; padding: 4px;">
                <ui:VisualElement picking-mode="Ignore" style="width: 36px; height: 36px; background-color: rgba(12, 14, 20, 0.9); border-width: 2px; border-color: rgba(212, 175, 55, 0.85); border-radius: 8px; align-items: center; justify-content: center; margin-right: 10px;">
                    <ui:Label picking-mode="Ignore" text="W" style="color: rgb(255, 215, 0); font-size: 16px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="FavoriteSlotIconW" picking-mode="Ignore" style="width: 32px; height: 32px; margin-right: 8px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.4);" />
                <ui:Label name="FavoriteSlotLabelW" picking-mode="Ignore" text="비어있음" style="color: rgb(240, 240, 240); font-size: 13px; background-color: rgba(0, 0, 0, 0.6); padding-left: 6px; padding-right: 6px; border-radius: 4px;" />
            </ui:VisualElement>

            <!-- E: 즐겨찾기 슬롯 1 -->
            <ui:VisualElement name="FavoriteSlotE" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-bottom: 14px; margin-right: 40px; background-color: rgba(0, 0, 0, 0); border-radius: 8px; padding: 4px;">
                <ui:VisualElement picking-mode="Ignore" style="width: 36px; height: 36px; background-color: rgba(12, 14, 20, 0.9); border-width: 2px; border-color: rgba(212, 175, 55, 0.85); border-radius: 8px; align-items: center; justify-content: center; margin-right: 10px;">
                    <ui:Label picking-mode="Ignore" text="E" style="color: rgb(255, 215, 0); font-size: 16px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="FavoriteSlotIconE" picking-mode="Ignore" style="width: 32px; height: 32px; margin-right: 8px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.4);" />
                <ui:Label name="FavoriteSlotLabelE" picking-mode="Ignore" text="비어있음" style="color: rgb(240, 240, 240); font-size: 13px; background-color: rgba(0, 0, 0, 0.6); padding-left: 6px; padding-right: 6px; border-radius: 4px;" />
            </ui:VisualElement>

            <!-- F: 즐겨찾기 슬롯 2 -->
            <ui:VisualElement name="FavoriteSlotF" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-right: 60px; background-color: rgba(0, 0, 0, 0); border-radius: 8px; padding: 4px;">
                <ui:VisualElement picking-mode="Ignore" style="width: 36px; height: 36px; background-color: rgba(12, 14, 20, 0.9); border-width: 2px; border-color: rgba(212, 175, 55, 0.85); border-radius: 8px; align-items: center; justify-content: center; margin-right: 10px;">
                    <ui:Label picking-mode="Ignore" text="F" style="color: rgb(255, 215, 0); font-size: 16px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="FavoriteSlotIconF" picking-mode="Ignore" style="width: 32px; height: 32px; margin-right: 8px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.4);" />
                <ui:Label name="FavoriteSlotLabelF" picking-mode="Ignore" text="비어있음" style="color: rgb(240, 240, 240); font-size: 13px; background-color: rgba(0, 0, 0, 0.6); padding-left: 6px; padding-right: 6px; border-radius: 4px;" />
            </ui:VisualElement>

            <!-- Q로 펼치는 장착 유닛 전체 목록 서브패널(기본 숨김) -->
            <ui:VisualElement name="MagicFullListContainer" picking-mode="Ignore" style="position: absolute; top: 0px; right: 240px; width: 320px; max-height: 360px; background-color: rgba(10, 10, 15, 0.95); border-color: rgb(255, 215, 0); border-width: 2px; border-radius: 12px; padding: 12px; display: none;">
                <ui:VisualElement name="MagicFullListGrid" picking-mode="Ignore" style="flex-direction: row; flex-wrap: wrap; align-content: flex-start;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
