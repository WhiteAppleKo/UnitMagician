.hud-container {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 320px;
    padding: 12px;
    background-color: rgba(20, 20, 30, 0.85);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.stat-bar-container {
    margin-bottom: 8px;
}

.stat-bar-bg {
    height: 22px;
    background-color: rgba(40, 40, 50, 0.9);
    border-radius: 6px;
    overflow: hidden;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
}

.hp-fill {
    height: 100%;
    width: 100%;
    background-color: #e74c3c;
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.2s;
}

.mp-fill {
    height: 100%;
    width: 100%;
    background-color: #2980b9;
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.2s;
}

/* 19-A: 스태미나 바. 소모는 즉시 줄고(트랜지션 없음) 회복은 프레임마다 조금씩 차오른다. */
.stamina-fill {
    height: 100%;
    width: 100%;
    background-color: #27ae60;
    border-radius: 5px;
}

/* 13-C: 락온 큐 예상 마나 비용 표시. 현재 MP 바의 오른쪽 끝에서 비용만큼 겹쳐 그린다(부족하면 전체를 붉게). */
.mp-preview-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    display: none;
    background-color: rgba(255, 230, 120, 0.8);
}

.mp-preview-fill--insufficient {
    background-color: rgba(231, 76, 60, 0.9);
}

.mp-preview-label {
    position: absolute;
    right: 6px;
    top: 0;
    bottom: 0;
    display: none;
    -unity-text-align: middle-right;
    color: #ffe27a;
    font-size: 12px;
    -unity-font-style: bold;
}

.mp-preview-label--insufficient {
    color: #ff6b5b;
}

.focus-fill {
    height: 100%;
    width: 100%;
    background-color: #9b59b6;
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.2s;
}

.stat-label {
    position: absolute;
    width: 100%;
    -unity-text-align: middle-center;
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
}

.magic-slot-container {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 6px;
    background-color: rgba(30, 30, 40, 0.7);
    border-radius: 8px;
}

.magic-icon {
    width: 40px;
    height: 40px;
    background-color: rgba(50, 50, 60, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.magic-name {
    margin-left: 10px;
    color: #f1c40f;
    font-size: 14px;
    -unity-font-style: bold;
}
